{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "stampeded",
      "bump-minor-pre-major": true,
      "extra-files": [
        {
          "type": "toml",
          "path": "crates/stampeded/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "crates/stampeded-ffi/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.dependencies.stampeded.version"
        },
        {
          "type": "generic",
          "path": "ruby/lib/stampeded/version.rb"
        }
      ]
    }
  }
}
