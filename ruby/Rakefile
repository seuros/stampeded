# frozen_string_literal: true

require "rake/testtask"

Rake::TestTask.new(:test) do |t|
  t.libs << "test" << "lib"
  t.test_files = FileList["test/**/*_test.rb"]
  t.warning = false
end

# The test helper loads ruby/schema/schema.sql, which is a STAGED COPY of the
# real schema one directory up. Nothing forced it to be current, so editing
# schema/schema.sql and running the Ruby suite tested the PREVIOUS schema and
# passed -- the failure mode that hid an ownership-fencing change until the
# Rust suite caught it. Only :package depended on staging; now the tests do.
task test: :stage_schema

task default: :test

# ---------------------------------------------------------------------------
# Packaging.
#
# One gem, built once per platform, with the daemon binary inside it. This was
# a second gem (`stampeded-daemon`); see the gemspec for why it is not any more.
# ---------------------------------------------------------------------------

require "fileutils"
require "json"

# Platforms we ship.
#
# musl is not optional: most container images are Alpine, and a gnu binary
# there fails at exec with a linker error rather than anything actionable.
PLATFORMS = {
  "arm64-darwin"       => "aarch64-apple-darwin",
  "x86_64-darwin"      => "x86_64-apple-darwin",
  "aarch64-linux-gnu"  => "aarch64-unknown-linux-gnu",
  "x86_64-linux-gnu"   => "x86_64-unknown-linux-gnu",
  "aarch64-linux-musl" => "aarch64-unknown-linux-musl",
  "x86_64-linux-musl"  => "x86_64-unknown-linux-musl"
}.freeze

WORKSPACE = File.expand_path("..", __dir__)

desc "Copy schema/*.sql and LICENSE in from the repo root, ready to package"
task :stage_schema do
  # A real copy, not a symlink: `gem build` warns that symlinks are not
  # supported on all platforms, and a gem that unpacks without its licence on
  # Windows is not BSD-3 compliant.
  FileUtils.cp(File.join(WORKSPACE, "LICENSE"), File.join(__dir__, "LICENSE"))
  # NOT a symlink: `gem build` from an exported tarball would dangle. The Rust
  # side applies these same files, so the repo root is the one definition and
  # this is a copy of it.
  dest = File.join(__dir__, "schema")
  # Cleared first. Staging is a copy of the repo root, and leaving whatever a
  # previous run put here means a renamed or deleted file lingers in the gem
  # -- which is how the package ended up carrying both schema.sql and the
  # three numbered files it replaced.
  FileUtils.rm_rf(dest)
  FileUtils.mkdir_p(dest)
  FileUtils.cp(Dir[File.join(WORKSPACE, "schema", "*.sql")], dest)
  puts "staged #{Dir[File.join(dest, '*.sql')].size} schema file(s)"
end

# Ask cargo where it builds, rather than assuming <workspace>/target.
#
# CARGO_TARGET_DIR relocates it -- shared caches in CI do this routinely, and a
# hardcoded path then copies a binary that is not there, or worse, a stale one
# from a previous build. `cargo metadata` reports the real directory.
def cargo_target_root
  @cargo_target_root ||= Dir.chdir(WORKSPACE) do
    JSON.parse(`cargo metadata --no-deps --format-version 1`).fetch("target_directory")
  end
end

# `gem build` must run with Bundler's environment stripped.
#
# Under `bundle exec`, Bundler re-resolves this directory's gemspec against the
# lockfile, and a platform gem does not match the running platform's full
# triple: building arm64-darwin from an arm64-darwin-23 machine fails with
# "Could not find gems matching 'stampeded' valid for all resolution
# platforms". The working copy happened to have a lockfile that hid this; a
# fresh clone did not, so `rake package` failed for anyone who had just cloned.
#
# Same fix guardship uses for the same reason.
# The platform is set INSIDE the block, not before it. with_unbundled_env
# restores the environment snapshot Bundler took at load time, so anything the
# task exported afterwards is discarded -- including STAMPEDED_GEM_PLATFORM.
# Setting it outside silently produced the PLATFORMLESS stub gem, with no
# binary in it, under a name that looked like a successful platform build.
def build_gem(platform = nil)
  Bundler.with_unbundled_env do
    ENV["STAMPEDED_GEM_PLATFORM"] = platform
    sh "gem build stampeded.gemspec"
  end
end

desc "Build the daemon binary for one rubygems platform"
task :build_binary, [:platform] do |_t, args|
  platform = args[:platform] or abort "usage: rake build_binary[arm64-darwin]"
  target = PLATFORMS.fetch(platform) { abort "unknown platform #{platform}" }

  sh "cargo build --release --bin stampeded --target #{target} " \
     "--manifest-path #{WORKSPACE}/Cargo.toml"

  dest = File.join(__dir__, "libexec")
  FileUtils.mkdir_p(dest)
  FileUtils.cp(File.join(cargo_target_root, target, "release", "stampeded"),
               File.join(dest, "stampeded"))
  FileUtils.chmod(0o755, File.join(dest, "stampeded"))
end

desc "Package the gem for one platform, binary included"
task :package, [:platform] => :stage_schema do |_t, args|
  platform = args[:platform] or abort "usage: rake package[arm64-darwin]"
  Rake::Task["build_binary"].invoke(platform)
  build_gem(platform)
end

desc "Package the platformless gem: no binary, for platforms we do not build"
task package_generic: :stage_schema do
  ENV.delete("STAMPEDED_GEM_PLATFORM")
  build_gem
end

desc "List shippable platforms"
task :platforms do
  PLATFORMS.each { |gem_plat, rust| puts format("  %-20s %s", gem_plat, rust) }
end
